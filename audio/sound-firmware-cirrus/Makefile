LICENSE_FILE=	${WRKSRC}/LICENSE.cirrus
LICENSE_PERMS=	dist-mirror no-dist-sell pkg-mirror no-pkg-sell auto-accept

ONLY_FOR_ARCHS=	amd64 i386
ONLY_FOR_ARCHS_REASON=	the snd_cs35l54 driver is only built for x86

FLAVORS=	cs35l54

NO_ARCH=	yes
NO_BUILD=	yes
NO_WRKSUBDIR=	yes

FWDIR=		/boot/firmware

