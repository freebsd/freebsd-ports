PORTNAME=	vscode
DISTVERSION=	${VSCODE_VERSION}
CATEGORIES=	editors
DIST_SUBDIR=	${PORTNAME}

MAINTAINER=	tagattie@FreeBSD.org
COMMENT=	Visual Studio Code - Open Source ("Code - OSS")
WWW=		https://code.visualstudio.com/

LICENSE=	MIT
LICENSE_FILE=	${WRKSRC}/LICENSE.txt

ONLY_FOR_ARCHS=	amd64

PATCH_DEPENDS=	jq:textproc/jq
BUILD_DEPENDS=	typescript-devel>=7.1.0.d.20261105.1:lang/typescript-devel \
		jq:textproc/jq \
		rg:textproc/ripgrep \
		tgrep:textproc/tgrep \
		npm${NODEJS_SUFFIX}>0:www/npm${NODEJS_SUFFIX}
LIB_DEPENDS=	libbrotlidec.so:archivers/brotli \
		libcares.so:dns/c-ares \
		libicui18n.so:devel/icu \
		libllhttp.so:www/llhttp \
		libnghttp2.so:www/libnghttp2 \
		libnghttp3.so:www/libnghttp3 \
		libngtcp2.so:net/libngtcp2 \
		libsimdjson.so:devel/simdjson \
		libuv.so:devel/libuv \
		libzstd.so:archivers/zstd \
		libsqlite3.so:databases/sqlite3 \
		libsecret-1.so:security/libsecret

USES=		gssapi:mit localbase:ldflags nodejs:24,build npm:pnpm \
		pkgconfig python:build shebangfix

USE_GITHUB=	yes
GH_ACCOUNT=	microsoft

USE_CXXSTD=	c++20

SHEBANG_REGEX=	./(extensions|node_modules|resources|scripts|src)/.*(\.(pl|py|sh)|makeBlacker|makeFF)$$
PATHFIX_FILES=	src/vs/workbench/contrib/debug/node/terminals.ts

MAKE_ENV=	BUILD_SOURCEVERSION=${SOURCE_COMMIT_HASH} \
		VSCODE_QUALITY=stable \
		NODE_OPTIONS="--max-old-space-size=8192"

CFLAGS+=	-Wno-error=implicit-function-declaration

BINARY_ALIAS=	python=${PYTHON_CMD}

NPM_FETCH_CMD=		${NPM_CMDNAME} install
NPM_FETCH_FLAGS+=	--os freebsd \
			--os linux
MAKE_ENV+=		pnpm_config_store_dir=${WRKDIR}/node-modules-cache/${NPM_MODULE_CACHE} \
			pnpm_config_supported_architectures='{"os":["linux","freebsd"]}'

VSCODE_REH_OUT_DIR=	${WRKDIR}/vscode-reh-linux-${NODEJS_ARCH}

.include "Makefile.version"
.include <bsd.port.pre.mk>

NODEJS_ARCH=	${ARCH:S/amd64/x64/}
NODEJS_DIR=	${PORTSDIR}/www/node${NODEJS_VERSION}
.include "${NODEJS_DIR}/Makefile.version"

ELECTRON_VER_MAJOR=	43
ELECTRON_DIR=		${PORTSDIR}/devel/electron${ELECTRON_VER_MAJOR}
.include "${ELECTRON_DIR}/Makefile.version"

post-fetch:
	@if [ ! -r ${DISTDIR}/${DIST_SUBDIR}/electron.d.ts-${ELECTRON_VER} ]; then \
		${SETENV} ${FETCH_ENV} ${FETCH_CMD} -o ${DISTDIR}/${DIST_SUBDIR}/electron.d.ts-${ELECTRON_VER} \
			https://github.com/electron/electron/releases/download/v${ELECTRON_VER}/electron.d.ts; \
	fi

post-extract:
	@${CP} ${WRKSRC}/build/.moduleignore.linux \
		${WRKSRC}/build/.moduleignore.freebsd
	@${MKDIR} ${WRKSRC}/.build/typings
	@${CP} ${DISTDIR}/${DIST_SUBDIR}/electron.d.ts-${ELECTRON_VER} \
		${WRKSRC}/.build/typings/electron.d.ts

.ifndef MAINTAINER_MODE
post-patch:
	@jq -r '.nativeBuild.target="${NODEJS_PORTVERSION}"' ${WRKSRC}/remote/package.json > \
		${WRKSRC}/remote/package.json.jq && \
		${MV} ${WRKSRC}/remote/package.json.jq ${WRKSRC}/remote/package.json
	@${REINPLACE_CMD} -e 's/%%DISTVERSION%%/${DISTVERSION}/g' \
		${WRKSRC}/build/gulpfile.reh.ts \
		${WRKSRC}/build/gulpfile.vscode.ts
	@${REINPLACE_CMD} -e 's|%%LOCALBASE%%|${LOCALBASE}|' \
		${WRKSRC}/node_modules/.pnpm/typescript@${TYPESCRIPT_VERSION}/node_modules/typescript/lib/getExePath.js
	@(cd ${WRKSRC} && \
	${FIND} -E . -type f -iregex '${SHEBANG_REGEX}' \
		-exec ${SED} -i '' -e "s|/usr/bin/pgrep|/bin/pgrep|g" {} +)
	@(cd ${WRKSRC} && \
	${FIND} ${PATHFIX_FILES} -type f \
		-exec ${SED} -i '' -e "s|/usr/bin/pgrep|/bin/pgrep|g" {} +)
	@${SETENV} FILESDIR=${FILESDIR} \
		${SH} ${FILESDIR}/update-product-json.sh ${WRKSRC}
.endif

pre-build:
# rebuild native node modules
	@for dir in `node --input-type=module -e "console.log(JSON.stringify((await import('${WRKSRC}/build/npm/dirs.ts')).dirs))" | jq -r '.[]' | ${SED} -e 's/^$$/./'`; do \
		if [ "$${dir}" = "." ]; then \
			subdir=""; \
		else \
			subdir="$${dir}/"; \
		fi; \
		for moddir in `${FIND} ${WRKSRC}/$${subdir}node_modules -type f -name binding.gyp -exec ${DIRNAME} {} ';' 2> /dev/null`; do \
			if ${ECHO_CMD} $${moddir} | ${GREP} -Eqe '/build/(.+/)*node_modules/' || \
				${ECHO_CMD} $${moddir} | ${GREP} -Eqe '/remote/(.+/)*node_modules/'; then \
				${ECHO_MSG} "===>   Rebuilding native modules in $${moddir}"; \
				cd $${moddir} && \
				npm_env="npm_config_runtime=node \
					npm_config_target=${NODEJS_PORTVERSION} \
					npm_config_nodedir=${LOCALBASE}" && \
				${SETENV} ${MAKE_ENV} $${npm_env} \
					npm run --if-present install && \
				${SETENV} ${MAKE_ENV} $${npm_env} \
					npm exec node-gyp -- --jobs ${MAKE_JOBS_NUMBER} rebuild; \
			fi; \
		done; \
	done

do-build:
# setup download cache for node
	@${MKDIR} ${WRKSRC}/.build/node/v${NODEJS_PORTVERSION}/linux-${NODEJS_ARCH}
	@${CP} ${LOCALBASE}/bin/node \
		${WRKSRC}/.build/node/v${NODEJS_PORTVERSION}/linux-${NODEJS_ARCH}
# remove backup files so that they are not included in the package
	@${FIND} ${WRKSRC} -type f \( -name '*.bak' -o -name '*.orig' -o -name '*~' \) -delete
# build vscode remote extension host
	@cd ${WRKSRC} && \
	pnpm_env="pnpm_config_runtime=node \
		pnpm_config_target=${NODEJS_PORTVERSION} \
		pnpm_config_nodedir=${LOCALBASE}"; \
	max_tries=3; \
	count=0; \
	while true; do \
		${SETENV} ${MAKE_ENV} $${pnpm_env} \
			pnpm run gulp vscode-reh-linux-${NODEJS_ARCH}-min && break; \
		count=$$((count + 1)); \
		if [ $${count} -ge $${max_tries} ]; then \
			${ECHO_MSG} "Failed to build after $${max_tries} attempts."; \
			exit 1; \
		fi; \
		${ECHO_MSG} "Build failed, retrying... (attempt $${count})"; \
	done

post-build:
# @github/copilot-sdk-linux-<arch> -> @github/copilot-sdk-freebsd-<arch>
	@${MKDIR} ${VSCODE_REH_OUT_DIR}/node_modules/@github/copilot-sdk-freebsd-${NODEJS_ARCH}
	${TAR} -cf - -C ${VSCODE_REH_OUT_DIR}/node_modules/@github/copilot-sdk-linux-${NODEJS_ARCH} . | \
		${TAR} -xf - -C ${VSCODE_REH_OUT_DIR}/node_modules/@github/copilot-sdk-freebsd-${NODEJS_ARCH}
	@${MKDIR} ${VSCODE_REH_OUT_DIR}/node_modules/@github/copilot-sdk-freebsd-${NODEJS_ARCH}/ripgrep/bin/freebsd-${NODEJS_ARCH}
	${CP} ${LOCALBASE}/bin/rg ${VSCODE_REH_OUT_DIR}/node_modules/@github/copilot-sdk-freebsd-${NODEJS_ARCH}/ripgrep/bin/freebsd-${NODEJS_ARCH}
	@${MKDIR} ${VSCODE_REH_OUT_DIR}/node_modules/@github/copilot-sdk-freebsd-${NODEJS_ARCH}/tgrep/bin/freebsd-${NODEJS_ARCH}
	${CP} ${LOCALBASE}/bin/tgrep ${VSCODE_REH_OUT_DIR}/node_modules/@github/copilot-sdk-freebsd-${NODEJS_ARCH}/tgrep/bin/freebsd-${NODEJS_ARCH}
# @vscode/ripgrep-universal
	@${MKDIR} ${VSCODE_REH_OUT_DIR}/node_modules/@vscode/ripgrep-universal/bin/freebsd-${NODEJS_ARCH}
	${CP} ${LOCALBASE}/bin/rg ${VSCODE_REH_OUT_DIR}/node_modules/@vscode/ripgrep-universal/bin/freebsd-${NODEJS_ARCH}
# @github/copilot in extensions
	@${MKDIR} ${VSCODE_REH_OUT_DIR}/extensions/copilot/node_modules/@github/copilot/sdk/ripgrep/bin/freebsd-${NODEJS_ARCH}
	${CP} ${LOCALBASE}/bin/rg ${VSCODE_REH_OUT_DIR}/extensions/copilot/node_modules/@github/copilot/sdk/ripgrep/bin/freebsd-${NODEJS_ARCH}
	@${MKDIR} ${VSCODE_REH_OUT_DIR}/extensions/copilot/node_modules/@github/copilot/sdk/tgrep/bin/freebsd-${NODEJS_ARCH} \
		${VSCODE_REH_OUT_DIR}/extensions/copilot/node_modules/@github/copilot/tgrep/bin/freebsd-${NODEJS_ARCH}
	${CP} ${LOCALBASE}/bin/tgrep ${VSCODE_REH_OUT_DIR}/extensions/copilot/node_modules/@github/copilot/sdk/tgrep/bin/freebsd-${NODEJS_ARCH}
	${CP} ${LOCALBASE}/bin/tgrep ${VSCODE_REH_OUT_DIR}/extensions/copilot/node_modules/@github/copilot/tgrep/bin/freebsd-${NODEJS_ARCH}
# remove directories containing linux-specific binaries
	@${FIND} ${VSCODE_REH_OUT_DIR} \
		-type d \( -name linux-arm64 -o -name linux-x64 \) -exec ${RM} -r {} +
	@${FIND} ${VSCODE_REH_OUT_DIR} \
		-type d -empty -delete
	@${RM} -r ${VSCODE_REH_OUT_DIR}/node_modules/@github/copilot-sdk-linux-${NODEJS_ARCH}
# strip native node modules
	@${FIND} ${WRKDIR}/vscode-reh-linux-${NODEJS_ARCH} -type f -exec ${FILE} {} + | \
		${GREP} 'ELF.*FreeBSD' | ${AWK} -F ': ' '{print $$1}' | ${XARGS} ${STRIP_CMD}
	${TAR} -czf ${WRKDIR}/vscode-reh-${OPSYS:tl}-${NODEJS_ARCH}-${DISTVERSION}.tar.gz \
		-C ${WRKDIR}/vscode-reh-linux-${NODEJS_ARCH} .

.include <bsd.port.post.mk>
