+      $JRETOOLKITDIR  = '$JAVA_HOME'.$ds."jre".$ds."lib".$ds.$jrearch.$ds."server";
+      $JRETHREADDIR   = '$JAVA_HOME'.$ds."jre".$ds."lib".$ds.$jrearch.$ds."native_threads";
    }
    elsif ($platform =~ m/powerpc/)
    {  print "Setting FreeBSD PPC specific values... ";
