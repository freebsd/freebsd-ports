--- set_soenv.in.orig	2026-09-18 00:50:35 UTC
+++ set_soenv.in
@@ -383,7 +383,7 @@ elsif ( $platform =~ m/freebsd/ )
          $JRETHREADDIR   = '$JAVA_HOME'.$ds."jre".$ds."lib".$ds."amd64".$ds."native_threads";
       }
    }
-   elsif ($platform =~ m/^i386/)
+   elsif ($platform =~ m/^i[3456]86/)
