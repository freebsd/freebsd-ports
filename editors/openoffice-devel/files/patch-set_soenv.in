       $outfile        = "FreeBSDX86Env.Set";
       $CPU            = "I";
@@ -410,9 +410,10 @@ elsif ( $platform =~ m/freebsd/ )
       $CPU            = "P";
       $CPUNAME        = "POWERPC64";
       $OUTPATH        = "unxfbsdppc64";
-      $JRELIBDIR      = '$JAVA_HOME'.$ds."jre".$ds."lib".$ds."ppc64";
-      $JRETOOLKITDIR  = '$JAVA_HOME'.$ds."jre".$ds."lib".$ds."ppc64".$ds."server";
