[
{ type: install
  message: <<EOM
This package contains the sources of the json_status module only.  It does
not install a loadable module.

The module itself is built by the nginx ports.  To use json_status, build
www/nginx, www/nginx-devel or www/freenginx with the HTTP_JSON_STATUS option
enabled.  Those ports pick the sources up from
%%PREFIX%%/share/nginx/modules/nginx-module-json-status and produce
ngx_http_json_status_module.so.
EOM
}
]
