[
{ type: install
  message: <<EOM
This package contains the sources of the form_input module only.  It
does not install a loadable module.

The module itself is built by the nginx ports.  To use form_input,
build www/nginx, www/nginx-devel or www/freenginx with the FORMINPUT
option enabled.  Those ports pick the sources up from
%%PREFIX%%/share/nginx/modules/nginx-module-form-input and produce
ngx_http_form_input_module.so.
EOM
}
]
