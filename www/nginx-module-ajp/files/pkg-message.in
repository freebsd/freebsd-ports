[
{ type: install
  message: <<EOM
This package contains the sources of the AJP module only.  It does not
install a loadable module.

The module itself is built by the nginx ports.  To use AJP, build
www/nginx, www/nginx-devel or www/freenginx with the AJP option
enabled.  Those ports pick the sources up from
%%PREFIX%%/share/nginx/modules/nginx-module-ajp and produce
ngx_http_ajp_module.so.
EOM
}
]
