[program:metrics]
command=%%WWWDIR%%/documentserver/server/Metrics/metrics ./config/config.js
directory=%%WWWDIR%%/documentserver/server/Metrics
user=%%DS_USERNAME%%
environment=NODE_DISABLE_COLORS=1
stdout_logfile=%%DS_LOGDIR%%/metrics/out.log
stdout_logfile_backups=0
stdout_logfile_maxbytes=0
stderr_logfile=%%DS_LOGDIR%%/metrics/err.log
stderr_logfile_backups=0
stderr_logfile_maxbytes=0
autostart=true
autorestart=true
