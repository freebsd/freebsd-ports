{
  "services": {
    "CoAuthoring": {
      "token": {
        "enable": {
          "request": {
            "inbox": false,
            "outbox": false
          },
          "browser": false
        },
        "inbox": {
          "header": "Authorization"
        },
        "outbox": {
          "header": "Authorization"
        }
      },
      "secret": {
        "browser": {
          "string": "JWTsecretstring"
        },
        "inbox": {
          "string": "JWTsecretstring"
        },
        "outbox": {
          "string": "JWTsecretstring"
        },
        "session": {
          "string": "JWTsecretstring"
        }
      }
    }
  },
  "openpgpjs": {
    "_comment": "https://api.onlyoffice.com/docs/docs-api/get-started/configuration/server-config#openpgp-protocol",
    "encrypt": {
      "passwords": ["PGPguardsecretstring"]
    },
    "decrypt": {
      "passwords": ["PGPguardsecretstring"]
    }
  },
  "aesEncrypt": {
    "_comment": "https://api.onlyoffice.com/docs/docs-api/get-started/configuration/server-config#aes-256-gcm-algorithm",
    "secret": "docpasswordsecretstring"
  },
  "storage": {
    "name": "storage-fs",
    "fs": {
      "secretString": "verysecretstring"
    }
  }
}
