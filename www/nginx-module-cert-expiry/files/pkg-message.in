[
{ type: install
  message: <<EOM
This package contains the sources of the cert_expiry module only.  It does
not install a loadable module.

The module itself is built by the nginx ports.  To use cert_expiry, build
www/nginx, www/nginx-devel or www/freenginx with the CERT_EXPIRY option
enabled.  Those ports pick the sources up from
%%PREFIX%%/share/nginx/modules/nginx-module-cert-expiry and produce
ngx_http_cert_expiry_module.so.
EOM
}
]
