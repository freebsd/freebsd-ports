[
{ type: install
  message: <<EOM
This package contains the sources of the link_func module only.  It does not
install a loadable module.

The module itself is built by the nginx ports.  To use link_func, build
www/nginx, www/nginx-devel or www/freenginx with the LINK option enabled.
Those ports pick the sources up from
%%PREFIX%%/share/nginx/modules/nginx-module-link and produce
ngx_http_link_func_module.so.
EOM
}
]
