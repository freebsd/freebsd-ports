[
{ type: install
  message: <<EOM
This package contains the sources of the dynamic_upstream module only.  It
does not install a loadable module.

The module itself is built by the nginx ports.  To use it, build www/nginx,
www/nginx-devel or www/freenginx with the DYNAMIC_UPSTREAM option enabled.
Those ports pick the sources up from
%%PREFIX%%/share/nginx/modules/nginx-module-dynamic-upstream and produce
ngx_http_dynamic_upstream_module.so.
EOM
}
]
