[
{ type: install
  message: <<EOM
This package contains the sources of the postgres module only.  It does not
install a loadable module.

The module itself is built by the nginx ports.  To use postgres, build
www/nginx, www/nginx-devel or www/freenginx with the POSTGRES option
enabled.  Those ports pick the sources up from
%%PREFIX%%/share/nginx/modules/nginx-module-postgres and produce
ngx_postgres_module.so.
EOM
}
]
