[
{ type: install
  message: <<EOM
This package contains the sources of the rtmp module only.
It does not install a loadable module.

The module itself is built by the nginx ports.  To use it, build
www/nginx, www/nginx-devel or www/freenginx with the RTMP option
enabled.  Those ports pick the sources up from
%%PREFIX%%/share/nginx/modules/nginx-module-rtmp
and produce ngx_rtmp_module.so.
EOM
}
]
