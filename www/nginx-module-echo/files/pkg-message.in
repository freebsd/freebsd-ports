[
{ type: install
  message: <<EOM
This package contains the sources of the echo module only.  It does not
install a loadable module.

The module itself is built by the nginx ports.  To use echo, build
www/nginx, www/nginx-devel or www/freenginx with the ECHO option enabled.
Those ports pick the sources up from
%%PREFIX%%/share/nginx/modules/nginx-module-echo and produce
ngx_http_echo_module.so.
EOM
}
]
