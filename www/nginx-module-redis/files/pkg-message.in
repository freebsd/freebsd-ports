[
{ type: install
  message: <<EOM
This package contains the sources of the redis module only.  It does not
install a loadable module.

The module itself is built by the nginx ports.  To use redis, build
www/nginx, www/nginx-devel or www/freenginx with the HTTP_REDIS option
enabled.  Those ports pick the sources up from
%%PREFIX%%/share/nginx/modules/nginx-module-redis and produce
ngx_http_redis_module.so.
EOM
}
]
