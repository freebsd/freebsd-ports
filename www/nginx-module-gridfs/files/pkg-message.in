[
{ type: install
  message: <<EOM
This package contains the sources of the gridfs module only.  It does not
install a loadable module.

The module itself is built by the nginx ports.  To use gridfs, build
www/nginx, www/nginx-devel or www/freenginx with the GRIDFS option
enabled.  Those ports pick the sources up from
%%PREFIX%%/share/nginx/modules/nginx-module-gridfs and produce
ngx_http_gridfs_module.so.
EOM
}
]
