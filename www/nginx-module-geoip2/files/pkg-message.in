[
{ type: install
  message: <<EOM
This package contains the sources of the geoip2 module only.  It does not
install a loadable module.

The module itself is built by the nginx ports.  To use it, build www/nginx,
www/nginx-devel or www/freenginx with the HTTP_GEOIP2 option enabled.
Those ports pick the sources up from
%%PREFIX%%/share/nginx/modules/nginx-module-geoip2
and produce ngx_http_geoip2_module.so and ngx_stream_geoip2_module.so.
EOM
}
]
