[
{ type: install
  message: <<EOM
This package contains the sources of the aws_auth module only.  It does not
install a loadable module.

The module itself is built by the nginx ports.  To use aws_auth, build
www/nginx, www/nginx-devel or www/freenginx with the AWS_AUTH option
enabled.  Those ports pick the sources up from
%%PREFIX%%/share/nginx/modules/nginx-module-aws-auth and produce
ngx_http_aws_auth_module.so.
EOM
}
]
