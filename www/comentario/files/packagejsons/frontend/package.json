{
    "name": "comentario-frontend",
    "version": "3.0.0",
    "private": true,
    "scripts": {
        "build": "ng build --configuration development && yarn run copy-assets && yarn run cleanup-assets",
        "build:prod": "ng build && yarn run copy-assets && yarn run cleanup-assets",
        "generate": "rm -rf generated-api/ && openapi-generator generate --additional-properties=ngVersion=22.1.0 -i ../resources/swagger/swagger.yml -g typescript-angular -o generated-api",
        "lint": "eslint",
        "start": "ng build --watch --configuration development",
        "test": "ng test",
        "copy-assets": "cp ../build/frontend/en/*.ico ../build/frontend/en/*.png ../build/frontend/en/*.svg ../build/frontend/en/*.xml ../build/frontend/en/*.txt ../build/frontend/en/site.webmanifest ../build/frontend/",
        "cleanup-assets": "rm -f ../build/frontend/*/*.ico ../build/frontend/*/*.png ../build/frontend/*/*.svg ../build/frontend/*/*.xml ../build/frontend/*/*.txt ../build/frontend/*/site.webmanifest"
    },
    "dependencies": {
        "@angular/animations": "^22.1.1",
        "@angular/common": "^22.1.1",
        "@angular/compiler": "^22.1.1",
        "@angular/core": "^22.1.1",
        "@angular/forms": "^22.1.1",
        "@angular/localize": "^22.1.1",
        "@angular/platform-browser": "^22.1.1",
        "@angular/platform-browser-dynamic": "^22.1.1",
        "@angular/router": "^22.1.1",
        "@fortawesome/angular-fontawesome": "^5.1.0",
        "@fortawesome/fontawesome-svg-core": "^7.3.1",
        "@fortawesome/free-brands-svg-icons": "^7.3.1",
        "@fortawesome/free-regular-svg-icons": "^7.3.1",
        "@fortawesome/free-solid-svg-icons": "^7.3.1",
        "@ng-bootstrap/ng-bootstrap": "^21.0.0",
        "@ngneat/until-destroy": "^10.0.0",
        "@popperjs/core": "^2.11.8",
        "bootstrap": "^5.3.8",
        "chart.js": "^4.5.1",
        "ng2-charts": "^10.0.0",
        "ngx-highlightjs": "^14.0.1",
        "rxjs": "^7.8.2",
        "tslib": "^2.8.1",
        "zone.js": "~0.16.2"
    },
    "devDependencies": {
        "@angular/build": "^22.1.3",
        "@angular/cli": "^22.1.3",
        "@angular/compiler-cli": "^22.1.1",
        "@openapitools/openapi-generator-cli": "^2.40.1",
        "@types/jsdom": "^30.0.0",
        "angular-eslint": "^22.1.0",
        "eslint": "^9.39.5",
        "jsdom": "^30.0.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.67.0",
        "vite": "^8.2.1",
        "vitest": "^4.1.10"
    },
    "peerDependencies": {
        "@angular/cdk": "^21.2.14"
    }
}
