# Settings for linkwarden_web and linkwarden_worker.  Everything in here is
# exported into the environment of both services, so any variable described in
# https://docs.linkwarden.app/self-hosting/environment-variables can be set.
#
# Keep this file readable by the linkwarden user only, it holds credentials:
#   chown root:linkwarden linkwarden.env && chmod 640 linkwarden.env

# Database, see the message of this package for how to create it
DATABASE_URL=postgresql://linkwarden:changeme@localhost:5432/linkwarden

# Public address of the instance and the session secret.  Generate the secret
# with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000/api/v1/auth
NEXTAUTH_SECRET=

# Where the archived pages are kept.  An absolute path is used as it is, a
# relative one is resolved against the directory above the installation.
#STORAGE_FOLDER=/var/db/linkwarden/data

# Username and password logins.  Set to false when only SSO should be allowed.
NEXT_PUBLIC_CREDENTIALS_ENABLED=true

# Set to true once the first account exists, so that nobody else can register.
#NEXT_PUBLIC_DISABLE_REGISTRATION=false

# Full text search over the archived pages needs a meilisearch instance,
# see textproc/meilisearch.  Without it the search covers names, urls,
# descriptions and tags.
#MEILI_HOST=http://127.0.0.1:7700
#MEILI_MASTER_KEY=

# Options passed to www/monolith when a page is saved as a single file
#MONOLITH_CUSTOM_OPTIONS=-j -F -q

# Time the worker waits for a page, in milliseconds
#BROWSER_TIMEOUT=

# Mail for password resets and invitations
#NEXT_PUBLIC_EMAIL_PROVIDER=true
#EMAIL_FROM=linkwarden@example.org
#EMAIL_SERVER=smtp://localhost:25
