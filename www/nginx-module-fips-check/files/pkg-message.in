[
{ type: install
  message: <<EOM
This package contains the sources of the fips_check module only.  It does not
install a loadable module.

The module itself is built by the nginx ports.  To use fips_check, build
www/nginx, www/nginx-devel or www/freenginx with the FIPS_CHECK option
enabled.  Those ports pick the sources up from
%%PREFIX%%/share/nginx/modules/nginx-module-fips-check and produce
ngx_fips_check_module.so.
EOM
}
]
