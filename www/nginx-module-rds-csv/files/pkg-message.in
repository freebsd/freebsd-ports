[
{ type: install
  message: <<EOM
This package contains the sources of the rds_csv module only.  It does not
install a loadable module.

The module itself is built by the nginx ports.  To use rds_csv, build
www/nginx, www/nginx-devel or www/freenginx with the RDS_CSV option enabled.
Those ports pick the sources up from
%%PREFIX%%/share/nginx/modules/nginx-module-rds-csv and produce
ngx_http_rds_csv_filter_module.so.
EOM
}
]
