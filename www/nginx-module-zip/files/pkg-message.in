[
{ type: install
  message: <<EOM
This package contains the sources of the zip module only.  It does not
install a loadable module.

The module itself is built by the nginx ports.  To use it, build
www/nginx, www/nginx-devel or www/freenginx with the HTTP_ZIP option
enabled.  Those ports pick the sources up from
%%PREFIX%%/share/nginx/modules/nginx-module-zip and produce
ngx_http_zip_module.so.
EOM
}
]
