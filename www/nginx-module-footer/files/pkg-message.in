[
{ type: install
  message: <<EOM
This package contains the sources of the footer module only.  It does not
install a loadable module.

The module itself is built by the nginx ports.  To use footer, build
www/nginx, www/nginx-devel or www/freenginx with the FOOTER option enabled.
Those ports pick the sources up from
%%PREFIX%%/share/nginx/modules/nginx-module-footer and produce
ngx_http_footer_filter_module.so.
EOM
}
]
