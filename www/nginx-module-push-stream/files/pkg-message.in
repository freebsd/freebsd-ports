[
{ type: install
  message: <<EOM
This package contains the sources of the push-stream module only.
It does not install a loadable module.

The module itself is built by the nginx ports.  To use it, build
www/nginx, www/nginx-devel or www/freenginx with the HTTP_PUSH_STREAM option
enabled.  Those ports pick the sources up from
%%PREFIX%%/share/nginx/modules/nginx-module-push-stream
and produce ngx_http_push_stream_module.so.
EOM
}
]
