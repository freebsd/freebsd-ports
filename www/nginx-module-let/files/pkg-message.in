[
{ type: install
  message: <<EOM
This package contains the sources of the let module only.  It does
not install a loadable module.

The module itself is built by the nginx ports.  To use let, build
www/nginx, www/nginx-devel or www/freenginx with the LET option
enabled.  Those ports pick the sources up from
%%PREFIX%%/share/nginx/modules/nginx-module-let and produce
ngx_http_let_module.so.
EOM
}
]
