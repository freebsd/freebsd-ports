[
{ type: install
  message: <<EOM
This package contains the sources of the dav_ext module only.  It does not
install a loadable module.

The module itself is built by the nginx ports.  To use dav_ext, build
www/nginx, www/nginx-devel or www/freenginx with the HTTP_DAV_EXT option
enabled.  Those ports pick the sources up from
%%PREFIX%%/share/nginx/modules/nginx-module-dav-ext and produce
ngx_http_dav_ext_module.so.
EOM
}
]
