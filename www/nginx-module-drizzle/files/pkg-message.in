[
{ type: install
  message: <<EOM
This package contains the sources of the drizzle module only.  It does not
install a loadable module.

The module itself is built by the nginx ports.  To use drizzle, build
www/nginx, www/nginx-devel or www/freenginx with the DRIZZLE option enabled.
Those ports pick the sources up from
%%PREFIX%%/share/nginx/modules/nginx-module-drizzle and produce
ngx_http_drizzle_module.so.
EOM
}
]
