# OpenCloud settings read by the rc.d script (sh syntax, one VAR=value per line).
# Copy to opencloud.env and adjust. Quote values that contain spaces.
#
# The data and config directories are compiled in, do NOT set HOME,
# OC_BASE_DATA_PATH or OC_CONFIG_DIR here unless you want to override them.
#
# Some settings are also stored in opencloud.yaml. After an upgrade or after
# changing variables below, run "service opencloud diffconfig" to see whether
# opencloud.yaml needs changes (see README.FreeBSD).

# Public URL of the instance.
OC_URL=https://cloud.example.com

# Listen address of the built-in proxy.
PROXY_HTTP_ADDR=0.0.0.0:9200

# Behind a reverse proxy (Caddy, Apache) on the same host that terminates
# TLS, use these two instead of the listen address above.
# See the README.FreeBSD in the documentation directory.
#PROXY_HTTP_ADDR=127.0.0.1:9200
#PROXY_TLS=false

# Accept HTTP basic auth. Upstream recommends to keep it disabled in
# production, enable it only if a client needs it.
#PROXY_ENABLE_BASIC_AUTH=true

# Only if TLS is terminated elsewhere or certificates are self-signed.
#OC_INSECURE=true
#OC_LDAP_INSECURE=true

OC_LOG_LEVEL=error

# Soft memory limit for the Go runtime.
GOMEMLIMIT=512MiB

# Storage driver for the system storage.
#STORAGE_SYSTEM_DRIVER=ocis

# External LDAP schema identifiers (only when an external LDAP is used).
#OC_LDAP_USER_SCHEMA_ID=owncloudUUID
#OC_LDAP_GROUP_SCHEMA_ID=owncloudUUID
