# Settings of immich-power-tools.  This file is read by the rc script as
# root and parsed as shell, so values holding spaces or any of $ ` " \ #
# must be quoted.  Keep it at mode 0640 owned by root:immich, it holds
# the API key and the database password.
IMMICH_URL=http://localhost:2283
IMMICH_API_KEY=changeme

# The database of that same server, as www/immich keeps it in
# %%PREFIX%%/etc/immich.env.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=immich
DB_PASSWORD=changeme
DB_DATABASE_NAME=immich
