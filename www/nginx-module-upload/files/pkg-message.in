[
{ type: install
  message: <<EOM
This package contains the sources of the upload module only.  It does not
install a loadable module.

The module itself is built by the nginx ports.  To use upload, build
www/nginx, www/nginx-devel or www/freenginx with the UPLOAD option enabled.
Those ports pick the sources up from
%%PREFIX%%/share/nginx/modules/nginx-module-upload and produce
ngx_http_upload_module.so.
EOM
}
]
