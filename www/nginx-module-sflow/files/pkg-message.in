[
{ type: install
  message: <<EOM
This package contains the sources of the sflow module only.  It does not
install a loadable module.

The module itself is built by the nginx ports.  To use sflow, build
www/nginx, www/nginx-devel or www/freenginx with the SFLOW option
enabled.  Those ports pick the sources up from
%%PREFIX%%/share/nginx/modules/nginx-module-sflow and produce
ngx_http_sflow_module.so.
EOM
}
]
