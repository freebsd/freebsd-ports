[
{ type: install
  message: <<EOM
This package contains the sources of the srcache module only.  It does not
install a loadable module.

The module itself is built by the nginx ports.  To use srcache, build
www/nginx, www/nginx-devel or www/freenginx with the SRCACHE option enabled.
Those ports pick the sources up from
%%PREFIX%%/share/nginx/modules/nginx-module-srcache and produce
ngx_http_srcache_filter_module.so.
EOM
}
]
