[
{ type: install
  message: <<EOM
This package contains the sources of the subs_filter module only.  It does not
install a loadable module.

The module itself is built by the nginx ports.  To use subs_filter, build
www/nginx, www/nginx-devel or www/freenginx with the HTTP_SUBS_FILTER option
enabled.  Those ports pick the sources up from
%%PREFIX%%/share/nginx/modules/nginx-module-subs-filter and produce
ngx_http_subs_filter_module.so.
EOM
}
]
