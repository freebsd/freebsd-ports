# The file is read by the rc scripts as a shell script.  Quote values that
# contain spaces or special characters.

# Shared secret between the web server and the local API server.  It must
# match the X-WorldMonitor-Local-Token value in the nginx configuration.
LOCAL_API_TOKEN=change-me-token

# Secret used to sign sessions, at least 32 characters.
WM_SESSION_SECRET=change-me-session-secret-at-least-32-chars

# Port of the local API server, it listens on 127.0.0.1 only.  It must match
# the port in the nginx server block.
LOCAL_API_PORT=46123

# Operating mode of the local API server.  "docker" is the upstream name of the
# mode for a self-hosted installation on a server, do not change it.
LOCAL_API_MODE=docker

# Redis REST proxy that the local API server uses for its data.  The port must
# match worldmonitor_redis_rest_port in /etc/rc.conf.  The proxy reads the same
# token from this file.  Use visible ASCII characters only, because the token is sent in an HTTP header.
UPSTASH_REDIS_REST_URL=http://127.0.0.1:8079
UPSTASH_REDIS_REST_TOKEN=change-me-redis-token

# Only for the sign-in feature, see "pkg info -D worldmonitor".  Set this to the issuer
# of your Clerk instance, for example https://your-instance.clerk.accounts.dev
#CLERK_JWT_ISSUER_DOMAIN=

# Optional keys.  Without them the matching panels stay empty.  All of them
# are read by the local API server, the relay and the seed service.
#OPENROUTER_API_KEY=
#LLM_API_URL=
#LLM_API_KEY=
#LLM_MODEL=
#FRED_API_KEY=
#EIA_API_KEY=
#FINNHUB_API_KEY=
#ALPHA_VANTAGE_API_KEY=
#ACLED_EMAIL=
#ACLED_PASSWORD=
#NASA_FIRMS_API_KEY=
#AVIATIONSTACK_API=
#AISSTREAM_API_KEY=
#CLOUDFLARE_API_TOKEN=
#GIE_API_KEY=
#AGSI_API_KEY=
#OPENAQ_API_KEY=
#WAQI_API_KEY=
#ENTSO_E_TOKEN=
#USPTO_API_KEY=

# Relay service for live aircraft, ship, siren and Telegram data.  The same
# secret must be used in both lines.  Generate one with: openssl rand -hex 32
RELAY_SHARED_SECRET=change-me-relay-secret-at-least-32-chars
WORLDMONITOR_RELAY_KEY=change-me-relay-secret-at-least-32-chars
# The port must match worldmonitor_relay_port in /etc/rc.conf.
WS_RELAY_URL=http://127.0.0.1:3004
