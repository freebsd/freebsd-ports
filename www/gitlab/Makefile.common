GITLAB_VERSION=		19.6.2
GITLAB_PORTREVISION=	4	# decrease this only if GITLAB_KAS_GRPC_VERSION is upgraded

# Git version gitaly should use (from gitlab mirror)
# Find current tag from Makefile and .gitlab-ci.yaml
# and from https://gitlab.com/gitlab-org/git/-/tags
GITLAB_GIT_VERSION=	2.54.0
# return something like x.yy
GITLAB_GIT_VERSION_SHORT=	${GITLAB_GIT_VERSION:C/^([0-9]*\.[0-9]*)\..*/\1/}
GITLAB_GIT_MASTER_VERSION=	47cf3453598906c8d3cdb75205d834ad0c23231e
GITLAB_GIT_PREV_VERSION=	6353e6bcf2c4483705153c390ec5245c0bf44fa4
GITLAB_GIT_VERSION_MVCC=	3aa3d8febe1a2aa20285c41fd4f74b1fc58bbfe7

# Overwrite version for gitlab-kas-grpc
#GITLAB_KAS_GRPC_VERSION=	${GITLAB_VERSION}
GITLAB_KAS_GRPC_VERSION=	19.4.0.pre.rc1

# Rails version
RAILS_VERSION=	8.0.5.2

