[
{ type: install
  message: <<EOM
This package contains the sources of the iconv module only.  It does not
install a loadable module.

The module itself is built by the nginx ports.  To use iconv, build
www/nginx, www/nginx-devel or www/freenginx with the ICONV option enabled.
Those ports pick the sources up from
%%PREFIX%%/share/nginx/modules/nginx-module-iconv and produce
ngx_http_iconv_module.so.
EOM
}
]
