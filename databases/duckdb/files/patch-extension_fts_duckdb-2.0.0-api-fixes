-- Apply upstream DuckDB v2.0.0 out-of-tree extension patches for the FTS extension.
-- These patches adapt the duckdb-fts submodule to the DuckDB 2.0.0 core API changes
-- (catalog includes, pragma function signatures, default schema handling).
-- Without them the extension fails to compile against DuckDB 2.0.0.
-- Source: https://github.com/duckdb/duckdb/tree/v2.0.0/.github/patches/extensions/fts
--- extension/fts/src/fts_indexing.cpp.orig
+++ extension/fts/src/fts_indexing.cpp
@@ -27,9 +27,15 @@ static QualifiedName GetQualifiedName(ClientContext &context,
     if (!qname.Catalog().empty()) {
       schema_path.push_back(qname.Catalog());
     }
-    schema_path.push_back(
+    auto default_schema =
         ClientData::Get(context).catalog_search_path->GetDefaultSchema(
-            context, qname.Catalog()));
+            context, qname.Catalog());
+    if (!default_schema) {
+      throw CatalogException("cannot resolve '%s' - catalog '%s' has no "
+                             "default schema, qualify the name with a schema",
+                             qname_str, qname.Catalog().GetIdentifierName());
+    }
+    schema_path.push_back(*default_schema);
     qname = qname.WithQualification(std::move(schema_path));
   }
   return qname;
--- extension/fts/src/fts_indexing.cpp.orig
+++ extension/fts/src/fts_indexing.cpp
@@ -3,6 +3,7 @@
 #include "fts_index_common.hpp"
 #include "fts_index_maintenance.hpp"
 
+#include "duckdb/catalog/catalog.hpp"
 #include "duckdb/catalog/catalog_entry/table_catalog_entry.hpp"
 #include "duckdb/catalog/catalog_search_path.hpp"
 #include "duckdb/common/exception.hpp"
--- extension/fts/src/include/fts_indexing.hpp.orig
+++ extension/fts/src/include/fts_indexing.hpp
@@ -9,6 +9,7 @@
 #pragma once
 
 #include "duckdb/main/client_context.hpp"
+#include "duckdb/function/function.hpp"
 
 namespace duckdb {
 
--- extension/fts/src/fts_extension.cpp.orig
+++ extension/fts/src/fts_extension.cpp
@@ -207,28 +207,34 @@ static void LoadInternal(ExtensionLoader &loader) {
       LogicalType::LIST(LogicalType::VARCHAR),
       OpenSearchStandardTokenizeFunction);
 
+  FunctionSignature create_fts_index_signature;
+  create_fts_index_signature.AddParameter("input_table", LogicalType::VARCHAR)
+	  .AddParameter("input_id", LogicalType::VARCHAR)
+	  .AddArgs("input_values", LogicalType::VARCHAR)
+	  .WithTypedKwargs("options", [&](TypedKwargs &options) {
+		  options.Add("stemmer", LogicalType::VARCHAR)
+		      .Add("tokenizer", LogicalType::VARCHAR)
+		      .Add("stopwords", LogicalType::VARCHAR)
+		      .Add("ignore", LogicalType::VARCHAR)
+		      .Add("strip_accents", LogicalType::BOOLEAN)
+		      .Add("lower", LogicalType::BOOLEAN)
+		      .Add("overwrite", LogicalType::BOOLEAN)
+		      .Add("incremental", LogicalType::BOOLEAN)
+		      .Add("cluster_terms", LogicalType::BOOLEAN)
+		      .Add("layered_search", LogicalType::BOOLEAN);
+	  });
   auto create_fts_index_func = PragmaFunction::PragmaCall(
       "create_fts_index", FTSIndexing::CreateFTSIndexQuery,
-      {LogicalType::VARCHAR, LogicalType::VARCHAR}, LogicalType::VARCHAR);
-  create_fts_index_func.named_parameters["stemmer"] = LogicalType::VARCHAR;
-  create_fts_index_func.named_parameters["tokenizer"] = LogicalType::VARCHAR;
-  create_fts_index_func.named_parameters["stopwords"] = LogicalType::VARCHAR;
-  create_fts_index_func.named_parameters["ignore"] = LogicalType::VARCHAR;
-  create_fts_index_func.named_parameters["strip_accents"] =
-      LogicalType::BOOLEAN;
-  create_fts_index_func.named_parameters["lower"] = LogicalType::BOOLEAN;
-  create_fts_index_func.named_parameters["overwrite"] = LogicalType::BOOLEAN;
-  create_fts_index_func.named_parameters["incremental"] = LogicalType::BOOLEAN;
-  create_fts_index_func.named_parameters["cluster_terms"] =
-      LogicalType::BOOLEAN;
-  create_fts_index_func.named_parameters["layered_search"] =
-      LogicalType::BOOLEAN;
-
-  auto drop_fts_index_func = PragmaFunction::PragmaCall(
-      "drop_fts_index", FTSIndexing::DropFTSIndexQuery, {LogicalType::VARCHAR});
+      std::move(create_fts_index_signature));
+
+  FunctionSignature input_table_signature;
+  input_table_signature.AddParameter("input_table", LogicalType::VARCHAR);
+  auto drop_fts_index_func =
+      PragmaFunction::PragmaCall("drop_fts_index", FTSIndexing::DropFTSIndexQuery,
+                                 input_table_signature);
   auto create_fts_boolean_query_macros_func = PragmaFunction::PragmaCall(
       "create_fts_boolean_query_macros",
-      FTSIndexing::CreateFTSBooleanQueryMacrosQuery, {LogicalType::VARCHAR});
+      FTSIndexing::CreateFTSBooleanQueryMacrosQuery, input_table_signature);
 
   loader.RegisterFunction(stem_func);
   loader.RegisterFunction(opensearch_standard_tokenize_func);
