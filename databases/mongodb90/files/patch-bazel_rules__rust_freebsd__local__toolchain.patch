++def _link_local_tool(ctx, prefix, tool_name, target_triple):
++    """Symlinks the files of a tool from a local Rust installation.
++
++    Args:
++        ctx (repository_ctx): A repository_ctx.
++        prefix (str): The prefix of the local Rust installation.
++        tool_name (str): The name of the tool per the archive naming.
++        target_triple (struct): The rust-style target triple of the tool.
++    """
++    if tool_name not in _LOCAL_TOOL_FILES:
++        fail("Tool {} is not supported with RULES_RUST_LOCAL_TOOLCHAIN".format(tool_name))
++    if not ctx.path("{}/lib/rustlib/{}".format(prefix, target_triple.str)).exists:
++        fail("Target {} is not installed in {}".format(target_triple.str, prefix))
++
++    todo = []
++    for pattern in _LOCAL_TOOL_FILES[tool_name]:
++        rel = pattern.format(triple = target_triple.str)
++        if rel.endswith("*"):
++            directory, _, file_prefix = rel[:-1].rpartition("/")
++            for child in ctx.path("{}/{}".format(prefix, directory)).readdir():
++                if child.basename.startswith(file_prefix):
++                    todo.append((child, "{}/{}".format(directory, child.basename)))
++        elif ctx.path("{}/{}".format(prefix, rel)).exists:
++            todo.append((ctx.path("{}/{}".format(prefix, rel)), rel))
++
++    # Starlark has no recursion or while loops.
++    for _ in range(100000):
++        if not todo:
++            break
++        src, dest = todo.pop()
++        if src.is_dir:
++            for child in src.readdir():
++                todo.append((child, "{}/{}".format(dest, child.basename)))
++        else:
++            ctx.symlink(src, dest)
++
++    # The llvm-tools component is not part of a regular Rust installation.
++    if tool_name == "llvm-tools":
++        binary_ext = system_to_binary_ext(target_triple.system)
++        for tool in ["llvm-cov", "llvm-profdata"]:
++            path = "lib/rustlib/{}/bin/{}{}".format(target_triple.str, tool, binary_ext)
++            if not ctx.path(path).exists:
++                ctx.file(path, "#!/bin/sh\necho \"{} is not available\" >&2\nexit 1\n".format(tool), executable = True)
++
