-- Make the FreeBSD entries in libs.json use the system-installed
-- libcurl-impersonate (from ftp/curl-impersonate) instead of downloading a
-- prebuilt static binary from GitHub, which is not possible in a sandboxed
-- build. link_type=dynamic with the system libdir makes download_libcurl()
-- early-exit and get_curl_libraries() link against the shared library.
-- Also add FreeBSD entries for architectures that upstream does not list.
-- Note: FreeBSD/aarch64's platform.uname().machine reports "arm64",
-- not "aarch64".

--- libs.json.orig	2026-10-26 04:01:55 UTC
+++ libs.json
@@ -52,8 +52,9 @@
         "machine": "amd64",
         "pointer_size": 64,
         "sysname": "freebsd",
-        "link_type": "static",
-        "obj_name": "libcurl-impersonate.a",
+        "link_type": "dynamic",
+        "libdir": "/usr/local/lib",
+        "obj_name": "libcurl-impersonate.so",
         "arch": "x86_64"
     },
     {
@@ -61,8 +62,9 @@
         "machine": "arm64",
         "pointer_size": 64,
         "sysname": "freebsd",
-        "link_type": "static",
-        "obj_name": "libcurl-impersonate.a",
+        "link_type": "dynamic",
+        "libdir": "/usr/local/lib",
+        "obj_name": "libcurl-impersonate.so",
         "arch": "aarch64"
     },
         {
@@ -70,9 +72,40 @@
         "machine": "riscv64",
         "pointer_size": 64,
         "sysname": "freebsd",
-        "link_type": "static",
-        "obj_name": "libcurl-impersonate.a",
+        "link_type": "dynamic",
+        "libdir": "/usr/local/lib",
+        "obj_name": "libcurl-impersonate.so",
         "arch": "riscv64"
+    },
+    {
+        "system": "FreeBSD",
+        "machine": "i686",
+        "pointer_size": 32,
+        "sysname": "freebsd",
+        "link_type": "dynamic",
+        "libdir": "/usr/local/lib",
+        "obj_name": "libcurl-impersonate.so",
+        "arch": "i386"
+    },
+    {
+        "system": "FreeBSD",
+        "machine": "armv7l",
+        "pointer_size": 32,
+        "sysname": "freebsd",
+        "link_type": "dynamic",
+        "libdir": "/usr/local/lib",
+        "obj_name": "libcurl-impersonate.so",
+        "arch": "arm"
+    },
+    {
+        "system": "FreeBSD",
+        "machine": "powerpc",
+        "pointer_size": 64,
+        "sysname": "freebsd",
+        "link_type": "dynamic",
+        "libdir": "/usr/local/lib",
+        "obj_name": "libcurl-impersonate.so",
+        "arch": "powerpc64"
     },
     {
         "system": "OpenBSD",
