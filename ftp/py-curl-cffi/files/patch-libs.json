-- Add FreeBSD entries to libs.json so the build system reuses the
-- system-installed libcurl-impersonate (from ftp/curl-impersonate)
-- instead of trying to download a prebuilt binary for FreeBSD (which
-- does not exist upstream). link_type=dynamic and the system libdir
-- make download_libcurl() early-exit and get_curl_libraries() link
-- against the dynamic library automatically, with no changes needed
-- to scripts/build.py itself.
-- Note: FreeBSD/aarch64's platform.uname().machine reports "arm64",
-- not "aarch64", hence the "machine": "arm64" entry below.

-- Upstreamed: https://github.com/lexiforest/curl_cffi/pull/870

--- libs.json.orig	2026-09-30 07:12:36 UTC
+++ libs.json
@@ -146,5 +146,55 @@
         "libc": "gnu",
         "obj_name": "libcurl-impersonate.a",
         "arch": "loongarch64"
+    },
+    {
+        "system": "FreeBSD",
+        "machine": "amd64",
+        "pointer_size": 64,
+        "sysname": "freebsd",
+        "link_type": "dynamic",
+        "libdir": "/usr/local/lib",
+        "obj_name": "libcurl-impersonate.so",
+        "arch": "amd64"
+    },
+    {
+        "system": "FreeBSD",
+        "machine": "i686",
+        "pointer_size": 32,
+        "sysname": "freebsd",
+        "link_type": "dynamic",
+        "libdir": "/usr/local/lib",
+        "obj_name": "libcurl-impersonate.so",
+        "arch": "i386"
+    },
+    {
+        "system": "FreeBSD",
+        "machine": "arm64",
+        "pointer_size": 64,
+        "sysname": "freebsd",
+        "link_type": "dynamic",
+        "libdir": "/usr/local/lib",
+        "obj_name": "libcurl-impersonate.so",
+        "arch": "aarch64"
+    },
+    {
+        "system": "FreeBSD",
+        "machine": "armv7l",
+        "pointer_size": 32,
+        "sysname": "freebsd",
+        "link_type": "dynamic",
+        "libdir": "/usr/local/lib",
+        "obj_name": "libcurl-impersonate.so",
+        "arch": "arm"
+    },
+    {
+        "system": "FreeBSD",
+        "machine": "powerpc64",
+        "pointer_size": 64,
+        "sysname": "freebsd",
+        "link_type": "dynamic",
+        "libdir": "/usr/local/lib",
+        "obj_name": "libcurl-impersonate.so",
+        "arch": "powerpc64"
     }
 ]
