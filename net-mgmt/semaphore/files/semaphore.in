#!/bin/sh

# PROVIDE: semaphore
# REQUIRE: LOGIN
# KEYWORD: shutdown
#
# semaphore_enable (bool):	Set to NO by default.
# semaphore_config (str):	Configuration file to use.
# semaphore_logfile (str):	File to write stdout and stderr to.

. /etc/rc.subr

name=semaphore
rcvar=semaphore_enable

load_rc_config ${name}

: ${semaphore_enable:="NO"}
: ${semaphore_config="%%PREFIX%%/etc/semaphore/config.json"}
: ${semaphore_logfile="/var/log/${name}.log"}

export PATH=${PATH}:%%PREFIX%%/bin

pidfile="/var/run/${name}.pid"
procname="%%PREFIX%%/bin/semaphore"
command="/usr/sbin/daemon"
command_args="-f -c -o ${semaphore_logfile} -p ${pidfile} /usr/bin/env ${semaphore_env} ${procname} server --config \"${semaphore_config}\""

run_rc_command "$1"
