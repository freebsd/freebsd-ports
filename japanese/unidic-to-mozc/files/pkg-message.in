[
{ type: install
  message: <<EOM
Dictionary Import Procedure:
Open the "Dictionary Tool" in Mozc.

$ mozc_tool dictionary_tool

Select "Tools" > "Import as new dictionary..."
Specify the %%DATADIR%%/mozc_unidic_merged_1.txt and execute the import.
If a personal name dictionary is required, follow the same procedure for
mozc_unidic_names_1.txt.
EOM
}
]
