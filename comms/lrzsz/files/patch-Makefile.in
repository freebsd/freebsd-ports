--- Makefile.in.orig	2026-10-04 09:37:14 UTC
+++ Makefile.in
@@ -945,6 +945,7 @@ $(SANITIZERS):
 		QUIET=1 make -s V=0 vcheck || exit 1 ; \
 	fi ; done
 
+.if defined(GMAKE)
 coverage: coverage/coverage.html
 coverage/coverage.html: $(wildcard src/*.c src/*.h)
 	mkdir coverage 2>/dev/null || exit 0
@@ -956,6 +957,7 @@ coverage/coverage.html: $(wildcard src/*.c src/*.h)
 	./configure -q
 	make -s V=0 clean
 	make -s V=0 -j 4
+.endif
 
