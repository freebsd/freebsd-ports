--- app/meson.build.orig	2026-10-05 10:26:14 UTC
+++ app/meson.build
@@ -74,8 +74,8 @@ feature_test_macros = [
 
 feature_test_macros = [
     '-D_GNU_SOURCE',
-    '-D_POSIX_C_SOURCE=200809L',
-    '-D_XOPEN_SOURCE=700',
+#     '-D_POSIX_C_SOURCE=200809L',
+#     '-D_XOPEN_SOURCE=700',
 ]
 
 conf = configuration_data()
@@ -105,12 +105,12 @@ add_project_arguments(feature_test_macros, language: '
 
 add_project_arguments(feature_test_macros, language: 'c')
 
-v4l2_support = get_option('v4l2') and host_machine.system() == 'linux'
+v4l2_support = get_option('v4l2') and (host_machine.system() == 'linux' or host_machine.system() == 'freebsd')
 if v4l2_support
     src += [ 'src/v4l2_sink.c' ]
 endif
 
-vaapi_support = get_option('vaapi') and host_machine.system() == 'linux'
+vaapi_support = get_option('vaapi') and (host_machine.system() == 'linux' or host_machine.system() == 'freebsd')
 if vaapi_support
     src += [ 'src/interop/interop_vaapi.c' ]
 endif
@@ -252,10 +252,10 @@ install_data('data/bash-completion/scrcpy',
 install_data('data/zsh-completion/_scrcpy',
              install_dir: datadir / 'zsh/site-functions')
 install_data('data/bash-completion/scrcpy',
-             install_dir: datadir / 'bash-completion/completions')
+             install_dir: 'etc/bash_completion.d')
 
 # Desktop entry file for application launchers
-if host_machine.system() == 'linux'
+if host_machine.system() == 'linux' or host_machine.system() == 'freebsd'
     # Install a launcher (ex: /usr/local/share/applications/scrcpy.desktop)
     install_data('data/scrcpy.desktop',
                  install_dir: datadir / 'applications')
