--- meson.build.orig	2026-08-04 00:24:43 UTC
+++ meson.build
@@ -166,6 +166,8 @@ libots = library('ots',
   include_directories: include_directories('include'),
   cpp_args : '-DHAVE_CONFIG_H',
   dependencies: ots_deps,
+  version : meson.project_version(),
+  install: true,
 )
 
 
@@ -192,6 +194,7 @@ ots_fuzzer = executable('ots-fuzzer',
   cpp_args: fuzzer_defines,
   link_with: libots,
   link_args: fuzzer_ldflags,
+  install: true,
 )
 
 
@@ -266,6 +269,7 @@ cff_charstring = executable('cff_charstring',
   link_with: libots,
   dependencies: gtest,
   override_options: ['cpp_std=c++17'],
+  install: true,
 )
 
 test('cff_charstring', cff_charstring)
