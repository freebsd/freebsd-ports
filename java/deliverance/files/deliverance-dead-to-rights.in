#!/bin/sh

: ${DELIVERANCE_DEAD_TO_RIGHTS_BASE_URL:="http://127.0.0.1:8080"}
: ${DELIVERANCE_DEAD_TO_RIGHTS_MODEL:="Qwen3-0.6B-JQ4"}
: ${DELIVERANCE_DEAD_TO_RIGHTS_MAX_TOKENS:="384"}
: ${DELIVERANCE_DEAD_TO_RIGHTS_TEMPERATURE:="0.8"}
: ${DELIVERANCE_DEAD_TO_RIGHTS_XTC_THRESHOLD:="0.1"}
: ${DELIVERANCE_DEAD_TO_RIGHTS_XTC_PROBABILITY:="0.2"}
: ${DELIVERANCE_DEAD_TO_RIGHTS_JAVA_OPTS:=""}

exec "%%JAVA%%" ${DELIVERANCE_DEAD_TO_RIGHTS_JAVA_OPTS} \
    -cp "%%NANOCODE_JAR%%" \
    io.teknek.deliverance.nanocode.game.DeadToRightsGame \
    --base-url "${DELIVERANCE_DEAD_TO_RIGHTS_BASE_URL}" \
    --model "${DELIVERANCE_DEAD_TO_RIGHTS_MODEL}" \
    --max-tokens "${DELIVERANCE_DEAD_TO_RIGHTS_MAX_TOKENS}" \
    --temperature "${DELIVERANCE_DEAD_TO_RIGHTS_TEMPERATURE}" \
    --xtc-threshold "${DELIVERANCE_DEAD_TO_RIGHTS_XTC_THRESHOLD}" \
    --xtc-probability "${DELIVERANCE_DEAD_TO_RIGHTS_XTC_PROBABILITY}" \
    "$@"
