-    whl_modifications = {
-        "@pypi_mods//:numpy.json": "numpy",
-    },
-)
-use_repo(pip, "pypi_mods", pypi = "xla_pypi")
+local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "local_repository")
 
-override_repo(
-    pip,
