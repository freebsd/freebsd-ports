+diff --git a/src/arm/freebsd/init.c b/src/arm/freebsd/init.c
+new file mode 100644
+index 0000000..549340a
+--- /dev/null
++++ b/src/arm/freebsd/init.c
+@@ -0,0 +1,196 @@
++#include <stdbool.h>
++#include <stdint.h>
++#include <stdlib.h>
++#include <string.h>
++
++#include <sys/auxv.h>
++#include <sys/sysctl.h>
++#include <sys/types.h>
++
++#include <machine/elf.h>
++
++#include <cpuinfo.h>
++#include <cpuinfo/internal-api.h>
++#include <cpuinfo/log.h>
++
++struct cpuinfo_arm_isa cpuinfo_isa = {0};
++
++static struct cpuinfo_package static_package = {
++	.name = "ARM64",
++};
++
++static uint32_t detect_processor_count(void) {
++	int ncpu = 0;
++	size_t size = sizeof(ncpu);
++	if (sysctlbyname("hw.ncpu", &ncpu, &size, NULL, 0) != 0 || ncpu <= 0) {
++		return 1;
++	}
++	return (uint32_t)ncpu;
++}
++
++static void detect_isa(void) {
++	unsigned long hwcap = 0;
++	unsigned long hwcap2 = 0;
++	if (elf_aux_info(AT_HWCAP, &hwcap, sizeof(hwcap)) != 0) {
++		hwcap = 0;
++	}
++	if (elf_aux_info(AT_HWCAP2, &hwcap2, sizeof(hwcap2)) != 0) {
++		hwcap2 = 0;
++	}
++
++	cpuinfo_isa.aes = !!(hwcap & HWCAP_AES);
++	cpuinfo_isa.pmull = !!(hwcap & HWCAP_PMULL);
++	cpuinfo_isa.sha1 = !!(hwcap & HWCAP_SHA1);
++	cpuinfo_isa.sha2 = !!(hwcap & HWCAP_SHA2);
++	cpuinfo_isa.crc32 = !!(hwcap & HWCAP_CRC32);
++	cpuinfo_isa.atomics = !!(hwcap & HWCAP_ATOMICS);
++	cpuinfo_isa.fp16arith = (hwcap & (HWCAP_FPHP | HWCAP_ASIMDHP)) == (HWCAP_FPHP | HWCAP_ASIMDHP);
++	cpuinfo_isa.rdm = !!(hwcap & HWCAP_ASIMDRDM);
++	cpuinfo_isa.dot = !!(hwcap & HWCAP_ASIMDDP);
++	cpuinfo_isa.jscvt = !!(hwcap & HWCAP_JSCVT);
++	cpuinfo_isa.fcma = !!(hwcap & HWCAP_FCMA);
++	cpuinfo_isa.fhm = !!(hwcap & HWCAP_ASIMDFHM);
++	cpuinfo_isa.i8mm = !!(hwcap2 & HWCAP2_I8MM);
++	cpuinfo_isa.bf16 = !!(hwcap2 & HWCAP2_BF16);
++	/* SVE and SME are not usable from userland on FreeBSD. */
++}
++
++void cpuinfo_arm_freebsd_init(void) {
++	struct cpuinfo_processor* processors = NULL;
++	struct cpuinfo_core* cores = NULL;
++	struct cpuinfo_cluster* clusters = NULL;
++	struct cpuinfo_cache* l1i = NULL;
++	struct cpuinfo_cache* l1d = NULL;
++	struct cpuinfo_cache* l2 = NULL;
++	struct cpuinfo_uarch_info* uarchs = NULL;
++
++	const uint32_t processor_count = detect_processor_count();
++
++	detect_isa();
++
++	processors = calloc(processor_count, sizeof(struct cpuinfo_processor));
++	cores = calloc(processor_count, sizeof(struct cpuinfo_core));
++	clusters = calloc(1, sizeof(struct cpuinfo_cluster));
++	l1i = calloc(processor_count, sizeof(struct cpuinfo_cache));
++	l1d = calloc(processor_count, sizeof(struct cpuinfo_cache));
++	l2 = calloc(1, sizeof(struct cpuinfo_cache));
++	uarchs = calloc(1, sizeof(struct cpuinfo_uarch_info));
++	if (processors == NULL || cores == NULL || clusters == NULL || l1i == NULL || l1d == NULL || l2 == NULL || uarchs == NULL) {
++		cpuinfo_log_error("failed to allocate memory for descriptions of %" PRIu32 " processors", processor_count);
++		goto cleanup;
++	}
++
++	static_package.processor_count = processor_count;
++	static_package.core_count = processor_count;
++	static_package.cluster_count = 1;
++
++	for (uint32_t i = 0; i < processor_count; i++) {
++		processors[i] = (struct cpuinfo_processor){
++			.smt_id = 0,
++			.core = cores + i,
++			.cluster = clusters,
++			.package = &static_package,
++			.cache.l1i = l1i + i,
++			.cache.l1d = l1d + i,
++			.cache.l2 = l2,
++		};
++
++		cores[i] = (struct cpuinfo_core){
++			.processor_start = i,
++			.processor_count = 1,
++			.core_id = i,
++			.cluster = clusters,
++			.package = &static_package,
++			.vendor = cpuinfo_vendor_unknown,
++			.uarch = cpuinfo_uarch_unknown,
++			.frequency = 0,
++		};
++
++		l1i[i] = (struct cpuinfo_cache){
++			.size = 64 * 1024,
++			.associativity = 4,
++			.sets = 256,
++			.partitions = 1,
++			.line_size = 64,
++			.processor_start = i,
++			.processor_count = 1,
++		};
++
++		l1d[i] = (struct cpuinfo_cache){
++			.size = 64 * 1024,
++			.associativity = 4,
++			.sets = 256,
++			.partitions = 1,
++			.line_size = 64,
++			.processor_start = i,
++			.processor_count = 1,
++		};
++	}
++
++	clusters[0] = (struct cpuinfo_cluster){
++		.processor_start = 0,
++		.processor_count = processor_count,
++		.core_start = 0,
++		.core_count = processor_count,
++		.cluster_id = 0,
++		.package = &static_package,
++		.vendor = cpuinfo_vendor_unknown,
++		.uarch = cpuinfo_uarch_unknown,
++		.frequency = 0,
++	};
++
++	l2[0] = (struct cpuinfo_cache){
++		.size = 1024 * 1024,
++		.associativity = 8,
++		.sets = 2048,
++		.partitions = 1,
++		.line_size = 64,
++		.processor_start = 0,
++		.processor_count = processor_count,
++	};
++
++	cpuinfo_cache[cpuinfo_cache_level_1i] = l1i;
++	cpuinfo_cache[cpuinfo_cache_level_1d] = l1d;
++	cpuinfo_cache[cpuinfo_cache_level_2] = l2;
++
++	cpuinfo_processors = processors;
++	cpuinfo_cores = cores;
++	cpuinfo_clusters = clusters;
++	cpuinfo_packages = &static_package;
++
++	cpuinfo_cache_count[cpuinfo_cache_level_1i] = processor_count;
++	cpuinfo_cache_count[cpuinfo_cache_level_1d] = processor_count;
++	cpuinfo_cache_count[cpuinfo_cache_level_2] = 1;
++
++	uarchs[0] = (struct cpuinfo_uarch_info){
++		.uarch = cpuinfo_uarch_unknown,
++		.processor_count = processor_count,
++		.core_count = processor_count,
++	};
++	cpuinfo_uarchs = uarchs;
++	cpuinfo_uarchs_count = 1;
++
++	cpuinfo_processors_count = processor_count;
++	cpuinfo_cores_count = processor_count;
++	cpuinfo_clusters_count = 1;
++	cpuinfo_packages_count = 1;
++
++	cpuinfo_max_cache_size = 1024 * 1024;
++
++	cpuinfo_is_initialized = true;
++
++	processors = NULL;
++	cores = NULL;
++	clusters = NULL;
++	l1i = l1d = l2 = NULL;
++	uarchs = NULL;
++
++cleanup:
++	free(processors);
++	free(cores);
++	free(clusters);
++	free(l1i);
++	free(l1d);
++	free(l2);
++	free(uarchs);
++}
