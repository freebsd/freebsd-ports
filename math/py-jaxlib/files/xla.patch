+local_repository(
+    name = "pypi",
+    path = "%%PYPI_STUB%%",
 )
 
 python_version_ext = use_extension("@rules_ml_toolchain//extensions:python_version.bzl", "python_version_ext")
diff --git a/third_party/cpuinfo/freebsd_arm64.patch b/third_party/cpuinfo/freebsd_arm64.patch
new file mode 100644
index 0000000..7d67077
--- /dev/null
+++ b/third_party/cpuinfo/freebsd_arm64.patch
@@ -0,0 +1,264 @@
+diff --git a/BUILD.bazel b/BUILD.bazel
+index 100ec80..78d6fdf 100755
+--- a/BUILD.bazel
++++ b/BUILD.bazel
