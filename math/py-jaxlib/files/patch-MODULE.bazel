-- Use the system Python and a stub pypi repo instead of pip, and patch protobuf and curl for FreeBSD. FreeBSD is not supported upstream; bazel cannot download wheels offline.
--- MODULE.bazel.orig	2026-10-20 13:31:57 UTC
+++ MODULE.bazel
@@ -136,6 +136,7 @@ single_version_override(
     patch_strip = 1,
     patches = [
         "//third_party/protobuf:protobuf_arena.patch",
+        "//third_party/protobuf:freebsd_upb.patch",
     ],
     version = "35.1",
 )
@@ -157,6 +158,24 @@ JAXLIB_VERSION = "0.9.2"
 
 JAXLIB_VERSION = "0.9.2"
 
+local_runtime_repo = use_repo_rule("@rules_python//python/local_toolchains:repos.bzl", "local_runtime_repo")
+
+local_runtime_repo(
+    name = "local_python3",
+    interpreter_path = "%%PYTHON_CMD%%",
+    on_failure = "fail",
+)
+
+local_runtime_toolchains_repo = use_repo_rule("@rules_python//python/local_toolchains:repos.bzl", "local_runtime_toolchains_repo")
+
+local_runtime_toolchains_repo(
+    name = "local_toolchains",
+    runtimes = ["local_python3"],
+    default_runtimes = ["local_python3"],
+)
+
+register_toolchains("@local_toolchains//:all")
+
 python = use_extension("@rules_python//python/extensions:python.bzl", "python")
 python.override(
     add_runtime_manifest_files = ["//third_party/py:rules_python_cpython_3_15.txt"],
@@ -175,59 +194,11 @@ python.toolchain(python_version = "3.15")
 python.toolchain(python_version = "3.15")
 
