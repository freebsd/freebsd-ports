PORTNAME=	jep
DISTVERSION=	4.3.2
CATEGORIES=	devel java python
MASTER_SITES=	PYPI
PKGNAMEPREFIX=	${PYTHON_PKGNAMEPREFIX}

MAINTAINER=	ports@FreeBSD.org
COMMENT=	Java Embedded Python
WWW=		https://github.com/mrj0/jep

LICENSE=	ZLIB
LICENSE_FILE=	${WRKSRC}/LICENSE

USES=		java python
USE_LDCONFIG=	yes
USE_PYTHON=	distutils

CONFIGURE_ENV=	JAVA_HOME=${JAVA_HOME}
MAKE_ENV=	JAVA_HOME=${JAVA_HOME}
PLIST_SUB=	VERSION=${DISTVERSION}

OPTIONS_DEFINE=	NUMPY
OPTIONS_DEFAULT=	NUMPY
NUMPY_BUILD_DEPENDS=	${PYTHON_PKGNAMEPREFIX}numpy>=1.16:math/py-numpy@${PY_FLAVOR}
NUMPY_RUN_DEPENDS=	${PYTHON_PKGNAMEPREFIX}numpy>=1.16:math/py-numpy@${PY_FLAVOR}

post-install:
	${RLN}  ${STAGEDIR}${PYTHON_SITELIBDIR}/jep/jep-${DISTVERSION}.jar \
		${STAGEDIR}${JAVAJARDIR}/jep.jar
	${STRIP_CMD} ${STAGEDIR}${PYTHONPREFIX_SITELIBDIR}/jep/jep*.so

.include <bsd.port.mk>
