LLVM_SUFFIX=	-devel

.include "${.PARSEDIR}/Makefile.snapshot"

PORTVERSION=	${LLVM_MAJOR}.0.d${SNAPDATE}
USE_GITHUB=	yes
GH_ACCOUNT=	llvm
GH_PROJECT=	llvm-project
GH_TAGNAME=	${LLVM_PROJECT_COMMIT}

CMAKE_ARGS+=	-DCMAKE_BUILD_WITH_INSTALL_RPATH=ON \
		-DLLVM_ENABLE_ASSERTIONS=ON

DOCS_BUILD_DEPENDS+=	${PYTHON_PKGNAMEPREFIX}furo>0:textproc/py-furo@${PY_FLAVOR}
