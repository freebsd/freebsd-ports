LLVM_SUFFIX=	-cheriot

.include "${.PARSEDIR}/Makefile.snapshot"

PORTVERSION=	${LLVM_MAJOR}.1.d${SNAPDATE}
USE_GITHUB=	yes
GH_ACCOUNT=	CHERIoT-Platform
GH_PROJECT=	llvm-project
GH_TAGNAME=	${LLVM_COMMIT}

WWW=		https://cheriot.org

NOT_FOR_ARCHS=		i386 armv6 armv7 powerpc
NOT_FOR_ARCHS_REASON=	No one will develop CHERI from 32-bit

LLVM_NO_BACKEND_OPTIONS=	yes
LLVM_TARGETS=	RISCV

# This snapshot never built the LLVM gold plugin.
OPTIONS_EXCLUDE+=	GOLD
