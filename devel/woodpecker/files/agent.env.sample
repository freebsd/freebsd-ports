# woodpecker-agent, read by the woodpecker_agent rc script.
# Every setting: https://woodpecker-ci.org/docs/administration/configuration/agent

# The server's gRPC address and the secret from its server.env.
WOODPECKER_SERVER=localhost:9000
WOODPECKER_AGENT_SECRET=

# Steps run directly on this host, as the agent's user.
WOODPECKER_BACKEND=local
WOODPECKER_MAX_WORKFLOWS=1

# Where the agent keeps its ID between restarts.
WOODPECKER_AGENT_CONFIG_FILE=/var/db/woodpecker/agent.conf
# Default :3000 collides with many web apps.
WOODPECKER_HEALTHCHECK_ADDR=127.0.0.1:3001
