# woodpecker-server, read by the woodpecker_server rc script.
# Every setting: https://woodpecker-ci.org/docs/administration/configuration/server

# The URL users reach the web UI at, as the forge redirects back to it.
WOODPECKER_HOST=https://ci.example.com

# Shared with every agent: generate with `openssl rand -hex 32`.
WOODPECKER_AGENT_SECRET=

# One forge. Forgejo shown; register an OAuth application there with the
# redirect URL ${WOODPECKER_HOST}/authorize.
WOODPECKER_FORGEJO=true
WOODPECKER_FORGEJO_URL=https://forgejo.example.com
WOODPECKER_FORGEJO_CLIENT=
WOODPECKER_FORGEJO_SECRET=

# Forge users allowed to administer this server.
#WOODPECKER_ADMIN=

WOODPECKER_SERVER_ADDR=:8000
WOODPECKER_GRPC_ADDR=:9000
WOODPECKER_DATABASE_DATASOURCE=/var/db/woodpecker/woodpecker.sqlite
