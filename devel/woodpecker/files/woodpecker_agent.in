#!/bin/sh

# PROVIDE: woodpecker_agent
# REQUIRE: LOGIN
# KEYWORD: shutdown
#
# Add the following lines to /etc/rc.conf to enable woodpecker_agent:
#
# woodpecker_agent_enable (bool):	Set to "YES" to enable.
#				Default: "NO"
# woodpecker_agent_env_file (str):	Its configuration, as environment
#				variables.
#				Default: "%%ETCDIR%%/agent.env"
# woodpecker_agent_user (str):	Default: "%%WOODPECKER_USER%%"

. /etc/rc.subr

name=woodpecker_agent
rcvar=woodpecker_agent_enable

load_rc_config $name

: ${woodpecker_agent_enable:="NO"}
: ${woodpecker_agent_env_file:="%%ETCDIR%%/agent.env"}
: ${woodpecker_agent_user:="%%WOODPECKER_USER%%"}
: ${woodpecker_agent_chdir:="/var/db/woodpecker"}

pidfile="/var/run/woodpecker/agent.pid"
procname="%%PREFIX%%/bin/woodpecker-agent"
command="/usr/sbin/daemon"
command_args="-c -p ${pidfile} -S -T ${name} ${procname}"
start_precmd="${name}_precmd"

woodpecker_agent_precmd()
{
	install -d -o ${woodpecker_agent_user} -m 755 /var/run/woodpecker
	export HOME=/var/db/woodpecker
}

run_rc_command "$1"
