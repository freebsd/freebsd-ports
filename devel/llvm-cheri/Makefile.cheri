# Shared by devel/llvm-cheri and devel/llvm-morello; included from their
# Makefile.version after LLVM_TARGETS is set.

NOT_FOR_ARCHS=		i386 armv6 armv7 powerpc
NOT_FOR_ARCHS_REASON=	No one will develop CHERI from 32-bit

LLVM_NO_BACKEND_OPTIONS=	yes

# These snapshots never built the LLVM gold plugin.
OPTIONS_EXCLUDE+=	GOLD

# files/llvm-wrapper.sh.in picks CHERI compiler flags based on the target.
SUB_LIST+=	CONFIGURE_TARGET="${CONFIGURE_TARGET}"
