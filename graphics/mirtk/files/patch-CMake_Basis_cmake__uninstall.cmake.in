-- Bump cmake_minimum_required to 3.5 for CMake 4.0 compatibility.
-- CMake 4.0 removed support for cmake_minimum_required(VERSION < 3.5).

--- CMake/Basis/cmake_uninstall.cmake.in.orig	2026-08-27 09:05:25 UTC
+++ CMake/Basis/cmake_uninstall.cmake.in
@@ -14,7 +14,7 @@
 # @ingroup CMakeTools
 ##############################################################################

-cmake_minimum_required (VERSION 2.8.12 FATAL_ERROR)
+cmake_minimum_required (VERSION 3.5 FATAL_ERROR)

 # ----------------------------------------------------------------------------
 # set the install prefix
