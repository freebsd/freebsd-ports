-- Determine the FreeBSD compiler-rt builtins directory dynamically instead
-- of hardcoding the OS version.  The installed LLVM package may place the
-- library under a different target triple (e.g. freebsd15.1) than the
-- x86_64-portbld-freebsd15.0 path baked into upstream; the port writes
-- the actual directory into .freebsd_clang_rt_dir at configure time.

--- build/config/clang/BUILD.gn.orig	2026-09-24 10:29:01 UTC
+++ build/config/clang/BUILD.gn
@@ -198,6 +198,12 @@ template("clang_lib") {
         }
       } else if (is_apple) {
         _dir = "darwin"
+      } else if (current_os == "freebsd") {
+        if (current_cpu == "x64") {
+          _dir = read_file("//.freebsd_clang_rt_dir", "trim string")
+        } else {
+          assert(false)  # Unhandled FreeBSD cpu type
+        }
       } else if (is_linux || is_chromeos) {
         if (current_cpu == "x64") {
           _dir = "x86_64-unknown-linux-gnu"
