CARGO_FEATURES=	heif
CARGO_BUILD_ARGS=	-p ${PORTNAME} -p ${PORTNAME}-cli
CARGO_ENV=	PHOTOCRAFT_BUILD_DATE=${RELEASE_DATE}
# Install the binaries of the joint build: a per-package cargo install
# unifies features differently and rebuilds most of the workspace
CARGO_INSTALL=	no

OPTIONS_DEFINE=	DOCS

APP_ID=		ai.storyteller.photocraft
RELEASE_DATE=	2026-10-08

post-patch:
	@${REINPLACE_CMD} -e 's|@VERSION@|${DISTVERSION}|; s|@DATE@|${RELEASE_DATE}|' \
		${WRKSRC}/packaging/linux/${APP_ID}.metainfo.xml.in

do-install:
	${INSTALL_PROGRAM} ${CARGO_TARGET_DIR}/release/${PORTNAME} \
		${CARGO_TARGET_DIR}/release/${PORTNAME}-cli ${STAGEDIR}${PREFIX}/bin
	${INSTALL_DATA} ${WRKSRC}/packaging/linux/${APP_ID}.desktop \
		${STAGEDIR}${PREFIX}/share/applications
	@${MKDIR} ${STAGEDIR}${PREFIX}/share/metainfo \
		${STAGEDIR}${PREFIX}/share/mime/packages
	${INSTALL_DATA} ${WRKSRC}/packaging/linux/${APP_ID}.metainfo.xml.in \
		${STAGEDIR}${PREFIX}/share/metainfo/${APP_ID}.metainfo.xml
	${INSTALL_DATA} ${WRKSRC}/packaging/linux/${APP_ID}.mime.xml \
		${STAGEDIR}${PREFIX}/share/mime/packages/${APP_ID}.xml
	cd ${WRKSRC}/assets/app-icon && \
		${COPYTREE_SHARE} hicolor ${STAGEDIR}${PREFIX}/share/icons
	@${MKDIR} ${STAGEDIR}${DOCSDIR}
	${INSTALL_DATA} ${WRKSRC}/ATTRIBUTION.md ${WRKSRC}/NOTICE \
		${STAGEDIR}${DOCSDIR}

post-install-DOCS-on:
	${INSTALL_DATA} ${WRKSRC}/README.md ${STAGEDIR}${DOCSDIR}

.include <bsd.port.mk>
