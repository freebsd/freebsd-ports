+#if defined(__FreeBSD__) && defined(MODINFOMD_EFI_FB)
+/* vt(efifb) remains active until drmfb takes over.  Its buffer need not start
+ * at the beginning of the VRAM BAR, unlike the reservation below.
+ */
+static unsigned int amdgpu_gmc_efifb_size(struct amdgpu_device *adev,
+				       unsigned int size)
+{
+	struct efi_fb *efifb;
+	u64 offset, end;
+
+	efifb = (struct efi_fb *)preload_search_info(preload_kmdp,
+	    MODINFO_METADATA | MODINFOMD_EFI_FB);
+	if (!efifb || !efifb->fb_size || efifb->fb_addr < adev->gmc.aper_base)
+		return size;
+	offset = efifb->fb_addr - adev->gmc.aper_base;
+	/* Ignore another device's framebuffer and reject overflowing ranges. */
+	if (offset >= adev->gmc.aper_size ||
+	    efifb->fb_size > adev->gmc.aper_size - offset)
+		return size;
+	end = offset + efifb->fb_size;
+	if (end > UINT_MAX)
+		return size;
+	return max(size, (unsigned int)end);
+}
+#endif
