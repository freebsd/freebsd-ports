--- meson.build.orig	2026-07-26 20:16:52 UTC
+++ meson.build
@@ -17,9 +17,8 @@ cairo = dependency('cairo')
 girara = dependency('girara')
 gtk4 = dependency('gtk4')
 cairo = dependency('cairo')
-libarchive = dependency('libarchive', version: '>=3')
 
-build_dependencies = [zathura, girara, gtk4, cairo, libarchive]
+build_dependencies = [zathura, girara, gtk4, cairo]
 
 if get_option('plugindir') == ''
   plugindir = zathura.get_variable(pkgconfig: 'plugindir')
@@ -55,6 +54,7 @@ cb = shared_module('cb',
   sources,
   dependencies: build_dependencies,
   c_args: defines + flags,
+  link_args: ['-larchive'],
   install: true,
   install_dir: plugindir,
   gnu_symbol_visibility: 'hidden'
