--- meson.build.orig	2026-04-17 08:37:38 UTC
+++ meson.build
@@ -177,7 +177,8 @@ platform_linux = (
 message('Host os: ' + host_os)
 
 platform_linux = (
-  host_os.contains('linux')
+  host_os.contains('linux') or
+  host_os.contains('bsd')
 )
 
 platform_windows = (
@@ -1264,7 +1265,7 @@ if have_lua
 if have_lua
   have_lua_lgi = false
 
-  foreach lua_bin : [ 'luajit', 'lua5.1', 'lua-5.1', 'lua' ]
+  foreach lua_bin : [ 'luajit', 'lua51', 'lua-5.1', 'lua' ]
     lua = find_program(lua_bin, required: false)
 
     if lua.found() and meson.can_run_host_binaries()
@@ -1303,7 +1304,7 @@ if have_lua
       if is_supported_lua
         have_lua_lgi = run_command(lua, '-e',
                                    '''
-                                   local lgi = require 'lgi'
+                                   local lgi = require("lgi")
                                    ''',
                                    check: false).returncode() == 0
       endif
@@ -1612,6 +1613,7 @@ conf.set('NO_FD_SET',
   not platform_windows
   and not cc.compiles('''
     #include <sys/types.h>
+    #include <sys/select.h>
     int main() { fd_set readMask, writeMask; return 0; }
   ''')
 )
