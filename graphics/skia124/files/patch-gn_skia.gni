-- Enable fontconfig on FreeBSD so Skia builds the font manager used by Aseprite.
-- FreeBSD is close enough to Linux for Skia's fontconfig and FreeType setup here.

--- gn/skia.gni.orig
+++ gn/skia.gni
@@ -48,3 +48,3 @@
   skia_use_ffmpeg = false
   skia_use_fixed_gamma_text = is_android
-  skia_use_fontconfig = is_linux
+  skia_use_fontconfig = is_linux || target_os == "freebsd"
   skia_use_fontations = false
   skia_use_fonthost_mac = is_mac || is_ios
   skia_use_freetype = is_android || is_fuchsia || is_linux || is_wasm
