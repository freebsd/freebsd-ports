PORTNAME=	polars-runtime
DISTVERSIONPREFIX=	py-
DISTVERSION=	1.44.2
CATEGORIES=	misc
#MASTER_SITES=	PYPI
PKGNAMEPREFIX=	${PYTHON_PKGNAMEPREFIX}

